{
  // Comprobación de tipos del hub: Remotion 4.0.543 + React 18.3.1 +
  // TypeScript 5.6.3 (devDependency). Solo comprueba, no emite.
  // Uso: npx tsc --noEmit   (con el Node del hub, ver activate.sh)
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2017", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    // Los Root.tsx importan ../project.json (id, dimensiones, fps).
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["shared", "projects", "templates"],
  "exclude": [
    "node_modules",
    // Ejemplos vendados de skills (.agents/skills/remotion-best-practices):
    // material de referencia con dependencias no instaladas (cesium, etc.),
    // no código del hub.
    ".agents"
  ]
}
