   "end": 4.52,
   "id": "L1",
   "start": 0.0,
   "text": "Este gráfico dice que Cuba compró 156 millones en combustible a Estados Unidos."
  },
  {
   "end": 6.46,
   "id": "L2",
   "start": 4.52,
   "text": "Y pregunta: ¿dónde está el bloqueo?"
  },
  {
   "end": 7.6,
   "id": "L3",
   "start": 6.76,
   "text": "La cifra es real."
  },
  {
   "end": 8.88,
   "id": "L4",
   "start": 8.02,
   "text": "Yo fui al documento."
  },
  {
   "end": 9.34,
   "id": "L5",
   "start": 9.2,
   "text": "Mira."
  },
  {
   "end": 10.36,
   "id": "L6",
   "start": 9.76,
   "text": "Es de julio."
  },
  {
   "end": 12.72,
   "id": "L7",
   "start": 10.66,
   "text": "La actualizada es 284 millones."
  },
  {
   "end": 15.16,
   "id": "L8",
   "start": 13.5,
   "text": "Pero eso no es lo interesante."
  },
  {
   "end": 17.1,
   "id": "L9",
   "start": 15.58,
   "text": "Lo interesante es quién compra."
  },
  {
   "end": 18.5,
   "id": "L10",
   "start": 17.44,
   "text": "El gráfico no dice quién."
  },
  {
   "end": 19.88,
   "id": "L11",
   "start": 18.82,
   "text": "El documento sí."
  },
  {
   "end": 21.4,
   "id": "L12",
   "start": 20.68,
   "text": "No es el Estado."
  },
  {
   "end": 25.6,
   "id": "L13",
   "start": 21.62,
   "text": "Son empresas privadas, con una licencia que se llama Apoyo al Pueblo Cubano."
  },
  {
   "end": 27.9,
   "id": "L14",
   "start": 25.6,
   "text": "Desde enero, un solo buque llevó al gobierno."
  },
  {
   "end": 29.12,
   "id": "L15",
   "start": 27.9,
   "text": "Y fíjate en esto."
  },
  {
   "end": 34.32,
   "id": "L16",
   "start": 29.44,
   "text": "En todo 2025, esa misma compra fue de 311 mil dólares."
  },
  {
   "end": 37.78,
   "id": "L17",
   "start": 34.44,
   "text": "De 311 mil dólares a 284 millones."
  },
  {
   "end": 39.26,
   "id": "L18",
   "start": 38.44,
   "text": "La cifra es real."
  },
  {
   "end": 40.64,
   "id": "L19",
   "start": 39.58,
   "text": "La conclusión, no."
  },
  {
   "end": 41.76,
   "id": "L20",
   "start": 41.16,
   "text": "Sin contexto."
  },
  {
   "end": 43.32,
   "id": "L21",
   "start": 42.32,
   "text": "¿Quién escribió el libreto?"
  }
